{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "eslint.validate": ["typescript"],
  "i18n-ally.namespace": true,
  "i18n-ally.sourceLanguage": "zh",
  "i18n-ally.displayLanguage": "zh",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.localesPaths": ["src/locales"],
  "i18n-ally.enabledParsers": ["yaml", "ts", "js", "json"],
  "i18n-ally.pathMatcher": "{locale}/{namespaces}.{ext}",
  "i18n-ally.enabledFrameworks": ["react-i18next"],
  "cSpell.words": [
    "vite",
    "windi",
    "windicss",
    "antd",
    "nprogress",
    "vitejs",
    "commitlint",
    "echarts",
    "pnpm",
    "antd",
    "iconify",
    "unocss",
    "axios",
    "Graphik",
    "Merriweather",
    "presetAttributify",
    "attributify",
    "camelcase",
    "parens",
    "paren",
    "Appstore",
    "brotliSize",
    "wangeditor",
    "stylelint",
    "liquidfill",
    "micromessenger",
    "crossorigin",
    "gifsicle",
    "optipng",
    "mozjpeg",
    "pngquant",
    "middlewares",
    "esbuild",
    "cssinjs",
    "zrender",
    "Optpng",
    "gridicons",
    "tsup",
    "YouSheBiaoTiHei",
    "zlevel",
    "majesticons",
    "Unactivate",
    "languagedetector",
    "locize",
    "zustand",
    "wechat",
    "unplugin",
    "geekblue",
    "Popconfirm",
    "nojekyll",
    "doubleclick",
    "googletagmanager",
    "googleads",
    "TTFB"
  ],
  "i18n-mage.i18nFeatures.framework": "react-i18next",
  "i18n-mage.i18nFeatures.interpolationBrackets": "double",
  "i18n-mage.i18nFeatures.defaultNamespace": "",
  "i18n-mage.workspace.languagePath": "packages/message",
  "i18n-mage.writeRules.keyStyle": "camelCase",
  "i18n-mage.writeRules.indentType": "space",
  "i18n-mage.writeRules.indentSize": 2,
  "i18n-mage.writeRules.quoteStyleForKey": "double",
  "i18n-mage.writeRules.quoteStyleForValue": "double",
  "i18n-mage.writeRules.languageStructure": "nested",
  "js/ts.tsdk.path": "node_modules/typescript/lib"
}

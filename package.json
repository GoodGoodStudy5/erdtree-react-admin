{
  "name": "south-admin-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/southliu/south-admin-react",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=11.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode dev",
    "build:test": "tsc && vite build --mode test",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "preview": "vite preview",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "init:project": "node .claude/skills/init-project/scripts/init.mjs"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{less,css,scss,postcss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,html}": "prettier --write"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.1",
    "@ant-design/icons": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify-json/ant-design": "^1.2.8",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/gridicons": "^1.2.5",
    "@iconify-json/icon-park": "^1.2.4",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/uil": "^1.2.3",
    "@south/message": "workspace:^",
    "@south/request": "workspace:^",
    "@south/utils": "workspace:^",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^6.1.3",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.6",
    "keepalive-for-react": "^5.0.7",
    "lodash": "^4.17.21",
    "motion": "^13.1.0",
    "nprogress": "^0.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-draggable": "^4.5.0",
    "react-i18next": "^17.0.11",
    "react-resizable": "^4.0.2",
    "react-router-dom": "^7.11.0",
    "react-window": "^2.2.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@iconify/react": "^6.0.2",
    "@sentry/react": "^10.38.0",
    "@south/stylelint": "workspace:^",
    "@types/lodash": "^4.17.21",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@unocss/preset-attributify": "^66.7.5",
    "@unocss/preset-icons": "^66.7.5",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "code-inspector-plugin": "^2.0.7",
    "eslint": "^9.39.2",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "less": "^4.5.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.7.4",
    "rc-picker": "^4.11.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^16.26.1",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^20.3.0",
    "vite": "^8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "web-vitals": "^6.1.1"
  }
}
